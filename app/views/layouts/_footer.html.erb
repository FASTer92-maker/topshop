<footer class="mt-16 bg-ink text-[#c9c9c9]">
  <div class="page-container py-12">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:gap-10">
      <div class="col-span-2 sm:col-span-1">
        <%= link_to root_path, class: "inline-block transition-opacity duration-300 hover:opacity-80" do %>
          <%= image_tag "logo.png", alt: t(".logo"), class: "h-7 w-auto brightness-0 invert" %>
        <% end %>
        <p class="mt-4 max-w-xs text-sm leading-relaxed tracking-[0.04em]"><%= t(".tagline") %></p>
      </div>

      <%# Pages behind these items are out of MVP scope, so they are plain text for now. %>
      <% %w[help shop documents].each do |section| %>
        <section>
          <h2 class="font-display text-sm font-medium uppercase tracking-wider text-white">
            <%= t(".sections.#{section}.title") %>
          </h2>
          <ul class="mt-3 space-y-2 text-sm tracking-[0.05em]">
            <% t(".sections.#{section}.items").each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="page-container flex flex-col gap-2 py-5 text-sm uppercase tracking-[0.08em] text-[#8a8a8a] sm:flex-row sm:justify-between">
      <p><%= t(".copyright", year: Date.current.year) %></p>
      <p><%= t(".region") %></p>
    </div>
  </div>
</footer>
