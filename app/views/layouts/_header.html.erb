<header class="sticky top-0 z-40 border-b border-line bg-white">
  <div class="page-container flex flex-wrap items-center gap-x-10 md:h-16 md:flex-nowrap">
    <%= link_to t(".logo"), root_path,
          class: "heading-display order-1 py-4 text-[26px] leading-none md:py-0",
          aria: { label: t(".logo_label") } %>

    <%# Main navigation: scrolls sideways on phones. %>
    <nav aria-label="<%= t(".main_nav") %>"
         class="order-3 -mx-4 w-[calc(100%+2rem)] overflow-x-auto border-t border-line px-4 md:order-2 md:mx-0 md:w-auto md:border-0 md:px-0">
      <ul class="flex gap-6 whitespace-nowrap py-3 text-[15px] font-medium md:py-0">
        <li>
          <%= link_to t(".all"), products_path,
                class: "border-b-2 pb-0.5 transition-colors #{current_page?(products_path) ? "border-ink" : "border-transparent hover:border-ink"}",
                aria: { current: (current_page?(products_path) ? "page" : nil) } %>
        </li>
        <% header_sections.each do |section| %>
          <li>
            <%= link_to section.name, category_path(section),
                  class: "border-b-2 pb-0.5 transition-colors #{catalog_section_current?(section) ? "border-ink" : "border-transparent hover:border-ink"}",
                  aria: { current: (catalog_section_current?(section) ? "page" : nil) } %>
          </li>
        <% end %>
      </ul>
    </nav>

    <%# User actions. Search is wired up in stage 9, the cart in stage 12. %>
    <ul class="order-2 ml-auto flex items-center gap-5 text-sm font-medium md:order-3 md:gap-8 md:text-[15px]">
      <li class="hidden sm:block"><span class="text-muted"><%= t(".search") %></span></li>
      <li>
        <% if authenticated? %>
          <%= render "layouts/account_menu", user: Current.user %>
        <% else %>
          <%= link_to t(".sign_in"), new_session_path, class: "transition-colors hover:text-accent" %>
        <% end %>
      </li>
      <li><span class="text-muted"><%= t(".cart", count: 0) %></span></li>
    </ul>
  </div>
</header>
