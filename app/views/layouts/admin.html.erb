<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · #{t('admin.layout.title')}" : t("admin.layout.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= favicon_link_tag "favicon.png", type: "image/png" %>
    <link rel="apple-touch-icon" href="<%= asset_path("favicon.png") %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oswald:wght@500;600;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-surface">
    <header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur-md">
      <div class="page-container">
        <div class="flex flex-wrap items-center gap-x-8 gap-y-3 py-4 lg:flex-nowrap">
          <%= link_to admin_root_path, class: "order-1 flex shrink-0 items-center gap-3 transition-opacity duration-300 hover:opacity-80" do %>
            <%= image_tag "logo.png", alt: "TopShop", class: "h-7 w-auto md:h-8" %>
            <span class="hidden border-l border-line pl-3 font-display text-sm font-medium uppercase tracking-wider text-muted sm:block">
              <%= t("admin.layout.title") %>
            </span>
          <% end %>

          <nav aria-label="<%= t("admin.layout.main_nav") %>"
               class="order-3 -mx-4 w-[calc(100%+2rem)] overflow-x-auto border-t border-line px-4 md:order-2 md:mx-0 md:w-auto md:overflow-visible md:border-0 md:px-0">
            <ul class="flex items-center gap-7 whitespace-nowrap py-3 text-sm font-medium uppercase tracking-[0.08em] lg:py-0">
              <li><%= link_to t("admin.layout.products"), admin_products_path, class: admin_nav_class("products") %></li>
              <li><%= link_to t("admin.layout.orders"), admin_orders_path, class: admin_nav_class("orders") %></li>
              <li><%= link_to t("admin.layout.categories"), admin_categories_path, class: admin_nav_class("categories") %></li>
            </ul>
          </nav>

          <ul class="order-2 ml-auto flex items-center gap-4 text-sm font-medium md:order-3">
            <li>
              <%= link_to t("admin.layout.back_to_site"), root_path,
                    class: "text-muted transition-colors duration-300 hover:text-accent" %>
            </li>
            <li>
              <%= button_to t("admin.layout.sign_out"), session_path, method: :delete,
                    class: "cursor-pointer text-muted transition-colors duration-300 hover:text-accent" %>
            </li>
          </ul>
        </div>
      </div>
    </header>

    <%= render "layouts/flash" %>

    <main class="page-container flex-1 py-8 md:py-10">
      <%= yield %>
    </main>

    <footer class="border-t border-line py-5">
      <p class="page-container text-center text-sm uppercase tracking-[0.14em] text-muted">
        TopShop · <%= t("admin.layout.title") %>
      </p>
    </footer>
  </body>
</html>
