<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · #{t('admin.layout.title')}" : t("admin.layout.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oswald:wght@500;600&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-surface">
    <header class="border-b border-line bg-white">
      <div class="page-container flex h-16 items-center gap-8">
        <%= link_to t("admin.layout.title"), admin_root_path,
              class: "heading-display text-lg", aria: { label: t("admin.layout.title") } %>

        <nav aria-label="<%= t('admin.layout.main_nav') %>" class="ml-auto flex items-center gap-6 text-sm font-medium">
          <%= link_to t("admin.layout.categories"), admin_categories_path, class: "transition-colors hover:text-accent" %>
          <%= link_to t("admin.layout.back_to_site"), root_path, class: "text-muted transition-colors hover:text-ink" %>
          <%= button_to t("admin.layout.sign_out"), session_path, method: :delete,
                class: "cursor-pointer font-medium text-muted transition-colors hover:text-ink" %>
        </nav>
      </div>
    </header>

    <%= render "layouts/flash" %>

    <main class="page-container flex-1 py-10">
      <%= yield %>
    </main>
  </body>
</html>
