<div id="flash" class="page-container empty:hidden">
  <% flash.each do |type, message| %>
    <% alert = type.to_s == "alert" %>
    <div data-controller="dismiss"
         role="<%= alert ? "alert" : "status" %>"
         class="mt-4 flex items-start justify-between gap-4 rounded-lg border px-4 py-3 <%= alert ? "border-danger text-danger" : "border-line bg-surface text-ink" %>">
      <p><%= message %></p>
      <button type="button"
              data-action="dismiss#close"
              class="-my-1 rounded-md px-2 py-1 text-lg leading-none text-muted hover:text-ink"
              aria-label="<%= t("layouts.flash.close") %>">&times;</button>
    </div>
  <% end %>
</div>
