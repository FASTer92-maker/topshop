<%# locals: (title:, text: nil, action_label: nil, action_path: nil, action_data: nil) -%>
<div class="mt-6 border border-line bg-white px-6 py-12 text-center">
  <p class="font-semibold"><%= title %></p>
  <% if text %>
    <p class="mt-2 text-muted"><%= text %></p>
  <% end %>
  <% if action_label && action_path %>
    <%= link_to action_label, action_path,
          class: "btn-primary mt-6",
          data: action_data %>
  <% end %>
</div>
