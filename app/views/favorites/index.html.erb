<% content_for :title, t(".title") %>

<div class="page-container py-10 md:py-14">
  <div class="border-b border-line pb-7">
    <p class="text-sm font-medium uppercase tracking-[0.24em] text-accent"><%= t(".eyebrow") %></p>
    <h1 class="heading-display mt-3 text-[34px] sm:text-[44px]"><%= t(".title") %></h1>
  </div>

  <% if @favorite_products.any? %>
    <ul class="mt-8 grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-3 lg:grid-cols-4 lg:gap-x-6 lg:gap-y-12">
      <% @favorite_products.each do |product| %>
        <li><%= render "products/product", product: product %></li>
      <% end %>
    </ul>
  <% else %>
    <div class="mt-8">
      <%= render "shared/empty_state", title: t(".empty.title"), text: t(".empty.text") %>
    </div>
  <% end %>
</div>
