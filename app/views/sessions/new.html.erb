<% content_for :title, t(".title") %>

<section class="page-container py-12 md:py-20">
  <div class="mx-auto max-w-md">
    <h1 class="heading-display text-[28px]"><%= t(".title") %></h1>
    <p class="mt-2 text-muted"><%= t(".subtitle") %></p>

    <%= form_with url: session_path, class: "mt-8 space-y-5" do |form| %>
      <div>
        <%= form.label :email_address, t(".email"), class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address], class: "form-input" %>
      </div>

      <div>
        <div class="flex items-baseline justify-between gap-4">
          <%= form.label :password, t(".password"), class: "form-label" %>
          <%= link_to t(".forgot_password"), new_password_path, class: "text-sm text-muted link-underline" %>
        </div>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
              class: "form-input" %>
      </div>

      <%= form.submit t(".submit"), class: "btn-primary w-full", data: { turbo_submits_with: t(".submitting") } %>
    <% end %>

    <p class="mt-8 border-t border-line pt-6 text-center text-sm text-muted">
      <%= t(".no_account") %>
      <%= link_to t(".sign_up"), new_registration_path, class: "font-medium text-ink link-underline" %>
    </p>
  </div>
</section>
