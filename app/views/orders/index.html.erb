<% content_for :title, t(".title") %>

<div class="page-container py-10 md:py-14">
  <div class="border-b border-line pb-7">
    <p class="text-sm font-medium uppercase tracking-[0.24em] text-accent"><%= t(".eyebrow") %></p>
    <h1 class="heading-display mt-3 text-[34px] sm:text-[44px]"><%= t(".title") %></h1>
    <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-muted"><%= t(".subtitle") %></p>
  </div>

  <% if @orders.empty? %>
    <div class="mt-8">
      <%= render "shared/empty_state", title: t(".empty.title"), text: t(".empty.text"),
            action_label: t(".empty.action"), action_path: products_path %>
    </div>
  <% else %>
    <div class="mt-8 overflow-hidden border border-line bg-white">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-left text-sm">
          <thead>
            <tr class="bg-surface text-[13px] uppercase tracking-[0.08em] text-muted">
              <th scope="col" class="px-5 py-4 font-medium"><%= t(".table.number") %></th>
              <th scope="col" class="px-5 py-4 font-medium"><%= t(".table.date") %></th>
              <th scope="col" class="px-5 py-4 text-right font-medium"><%= t(".table.total") %></th>
              <th scope="col" class="px-5 py-4 text-right font-medium"><%= t(".table.status") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @orders.each do |order| %>
              <tr class="transition-colors duration-300 hover:bg-surface/60">
                <td class="px-5 py-4">
                  <%= link_to t(".number", number: order.number), order_path(order),
                        class: "font-display text-base font-medium tracking-wide link-underline" %>
                  <p class="mt-1 text-sm text-muted"><%= t(".items", count: order.items_count) %></p>
                </td>
                <td class="whitespace-nowrap px-5 py-4 text-muted"><%= l(order.created_at, format: :short) %></td>
                <td class="whitespace-nowrap px-5 py-4 text-right font-semibold tabular-nums">
                  <%= number_to_currency(order.total) %>
                </td>
                <td class="px-5 py-4 text-right"><%= render "orders/status_badge", status: order %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
</div>
