<% content_for :title, t(".title") %>

<section class="relative flex min-h-[600px] items-end overflow-hidden bg-ink text-white lg:min-h-[700px]">
  <%= image_tag "hero.jpg", alt: "", class: "absolute inset-0 h-full w-full scale-105 object-cover object-center opacity-80" %>
  <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/70 to-ink/10"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent"></div>

  <div class="page-container relative z-10 py-14 md:py-20">
    <div class="max-w-2xl">
      <p class="flex items-center gap-3 text-sm font-medium uppercase tracking-[0.24em] text-accent">
        <span class="h-px w-10 bg-accent" aria-hidden="true"></span>
        <%= t(".hero.eyebrow") %>
      </p>
      <h1 class="heading-display mt-5 text-[46px] leading-[0.98] sm:text-6xl lg:text-7xl xl:text-8xl"><%= t(".hero.title") %></h1>
      <p class="mt-6 max-w-lg text-[15px] leading-relaxed text-white/75 sm:text-base"><%= t(".hero.text") %></p>

      <div class="mt-9 flex flex-wrap gap-3">
        <%= link_to t(".hero.cta"), products_path,
              class: "inline-flex items-center justify-center bg-white px-8 py-4 text-sm font-bold uppercase tracking-[0.14em] text-ink transition-colors duration-300 hover:bg-accent hover:text-white" %>
        <%= link_to t(".hero.cta_secondary"), products_path,
              class: "inline-flex items-center justify-center border border-white/70 px-8 py-4 text-sm font-bold uppercase tracking-[0.14em] text-white transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-white" %>
      </div>
    </div>
  </div>
</section>

<% if @banners.any? %>
  <section class="page-container pt-14 md:pt-20" aria-labelledby="home_banners_title">
    <h2 id="home_banners_title" class="sr-only"><%= t(".sections.title") %></h2>

    <div class="grid gap-5 md:grid-cols-2 lg:gap-6">
      <% @banners.each_with_index do |section, index| %>
        <%= link_to category_path(section),
              class: "group relative flex min-h-[360px] items-end overflow-hidden border border-line bg-ink p-7 text-white sm:min-h-[420px] sm:p-9" do %>
          <%= image_tag index.zero? ? "promo-men.jpg" : "promo-women.jpg", alt: "",
                class: "absolute inset-0 h-full w-full object-cover object-center opacity-85 transition-transform duration-700 ease-out group-hover:scale-105" %>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
          <div class="relative z-10">
            <span class="mb-4 block h-px w-10 bg-accent transition-all duration-500 group-hover:w-16" aria-hidden="true"></span>
            <h3 class="heading-display text-[30px] sm:text-[38px]"><%= section.name %></h3>
            <span class="mt-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-white/80 transition-colors duration-300 group-hover:text-accent">
              <%= t(".sections.cta") %>
              <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<section class="page-container py-14 md:py-20">
  <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-5">
    <div class="flex items-center gap-4">
      <h2 class="heading-display text-[26px] sm:text-[32px]"><%= t(".new_arrivals") %></h2>
    </div>
    <%= link_to products_path,
          class: "group flex items-center gap-2 border-b border-line pb-1 text-sm font-semibold uppercase tracking-[0.16em] transition-colors duration-300 hover:border-accent hover:text-accent" do %>
      <%= t(".all_products") %>
      <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    <% end %>
  </div>

  <% if @new_arrivals.any? %>
    <ul class="mt-9 grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 lg:grid-cols-4 lg:gap-x-6 lg:gap-y-12">
      <% @new_arrivals.each do |product| %>
        <li><%= render "products/product", product: product %></li>
      <% end %>
    </ul>
  <% else %>
    <%= render "shared/empty_state", title: t(".empty.title"), text: t(".empty.text") %>
  <% end %>
</section>
