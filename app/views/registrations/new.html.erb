<% content_for :title, t(".title") %>

<section class="page-container py-12 md:py-20">
  <div class="mx-auto max-w-md">
    <h1 class="heading-display text-[28px]"><%= t(".title") %></h1>
    <p class="mt-2 text-muted"><%= t(".subtitle") %></p>

    <%= form_with model: @user, url: registration_path, class: "mt-8 space-y-5" do |form| %>
      <%= render "shared/form_errors", object: @user %>

      <div>
        <%= form.label :email_address, class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email",
              class: "form-input" %>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :first_name, class: "form-label" %>
          <%= form.text_field :first_name, required: true, autocomplete: "given-name", maxlength: 50,
                class: "form-input" %>
        </div>
        <div>
          <%= form.label :last_name, class: "form-label" %>
          <%= form.text_field :last_name, required: true, autocomplete: "family-name", maxlength: 50,
                class: "form-input" %>
        </div>
      </div>

      <div>
        <%= form.label :password, class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
              minlength: User::PASSWORD_MIN_LENGTH, aria: { describedby: "password_hint" }, class: "form-input" %>
        <p id="password_hint" class="mt-1.5 text-sm text-muted">
          <%= t(".password_hint", count: User::PASSWORD_MIN_LENGTH) %>
        </p>
      </div>

      <div>
        <%= form.label :password_confirmation, class: "form-label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
              class: "form-input" %>
      </div>

      <%= form.submit t(".submit"), class: "btn-primary w-full", data: { turbo_submits_with: t(".submitting") } %>
    <% end %>

    <p class="mt-8 border-t border-line pt-6 text-center text-sm text-muted">
      <%= t(".have_account") %>
      <%= link_to t(".sign_in"), new_session_path, class: "font-medium text-ink link-underline" %>
    </p>
  </div>
</section>
