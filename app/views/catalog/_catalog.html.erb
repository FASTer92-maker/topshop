<%# locals: (pagy:, products:) -%>
<%= turbo_frame_tag "catalog" do %>
  <%= render "catalog/filters" %>

  <p class="mt-5 text-sm text-muted"><%= catalog_found_text(pagy.count) %></p>

  <% if products.any? %>
    <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-3 xl:grid-cols-4">
      <% products.each do |product| %>
        <li><%= render "products/product", product: product %></li>
      <% end %>
    </ul>

    <%= render "shared/pagination", pagy: pagy %>
  <% elsif catalog_filters_active? %>
    <%= render "shared/empty_state",
          title: t("catalog.empty.filtered_title"),
          text: t("catalog.empty.filtered_text"),
          action_label: t("catalog.empty.reset"),
          action_path: request.path,
          action_data: { turbo_frame: "catalog", turbo_action: "advance" } %>
  <% else %>
    <%= render "shared/empty_state", title: t("catalog.empty.title"), text: t("catalog.empty.text") %>
  <% end %>
<% end %>
