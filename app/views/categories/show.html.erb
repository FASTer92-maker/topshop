<% content_for :title, @category.name %>

<div class="page-container pb-20 pt-10 md:pt-14">
  <%= render "catalog/breadcrumbs", category: @category %>

  <div class="mt-8 text-center">
    <p class="text-[11px] font-medium uppercase tracking-[0.24em] text-accent"><%= t("catalog.eyebrow") %></p>
    <h1 class="heading-display mt-3 text-[38px] sm:text-5xl"><%= @category.name %></h1>
    <p class="mx-auto mt-4 max-w-xl text-[14px] leading-relaxed text-muted"><%= t("catalog.subtitle") %></p>
  </div>

  <% if @subcategories.present? %>
    <ul class="mt-7 flex flex-wrap justify-center gap-2">
      <% @subcategories.each do |subcategory| %>
        <li>
          <%= link_to subcategory.name, category_path(subcategory),
                class: "inline-block border border-line bg-white px-4 py-2 text-[11px] font-medium uppercase tracking-[0.1em] transition-colors duration-300 hover:border-accent hover:text-accent" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= render "catalog/catalog", pagy: @pagy, products: @products %>
</div>
