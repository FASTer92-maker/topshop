<% content_for :title, @category.name %>

<div class="page-container pb-16 pt-10 md:pt-14">
  <%= render "catalog/breadcrumbs", category: @category %>

  <div class="mt-6 text-center">
    <h1 class="heading-display text-[32px] sm:text-[40px]"><%= @category.name %></h1>
  </div>

  <% if @subcategories.present? %>
    <ul class="mt-5 flex flex-wrap justify-center gap-2">
      <% @subcategories.each do |subcategory| %>
        <li>
          <%= link_to subcategory.name, category_path(subcategory),
                class: "inline-block border border-line px-4 py-2 text-[12px] font-medium uppercase tracking-[0.06em] transition-colors hover:border-ink hover:text-accent" %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= render "catalog/catalog", pagy: @pagy, products: @products %>
</div>
