<%# locals: (product:) -%>
<% variants = product.variants.to_a %>
<% colors = product.colors %>
<%# The colour that has something in stock is opened first. %>
<% default_color = colors.find { |color| variants.any? { |variant| variant.color == color && variant.available? } } || colors.first %>
<% single_variant = variants.one? && variants.first.available? %>

<%# Stage 12 points the form to cart_items_path; until then the button only validates the size. %>
<%= form_with url: "#", method: :post, class: "mt-6",
      data: { controller: "variant-picker",
              action: "submit->variant-picker#submit",
              variant_picker_error_value: t(".size_required") } do %>

  <fieldset>
    <legend class="form-label"><%= t(".color") %></legend>

    <div class="flex flex-wrap gap-2">
      <% colors.each do |color| %>
        <label>
          <%= radio_button_tag :color, color, color == default_color, id: "color_#{color.parameterize}",
                class: "peer sr-only",
                data: { variant_picker_target: "color", color: color,
                        action: "change->variant-picker#selectColor" } %>
          <span class="inline-block cursor-pointer rounded-md border border-line px-4 py-2 text-sm font-medium transition-colors peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink"><%= color %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="mt-5">
    <legend class="form-label"><%= t(".size") %></legend>

    <% colors.each do |color| %>
      <% variants_of_color = variants.select { |variant| variant.color == color } %>
      <div class="flex flex-wrap gap-2 <%= "hidden" unless color == default_color %>"
           data-variant-picker-target="sizeGroup" data-size-color="<%= color %>">
        <% variants_of_color.each do |variant| %>
          <% stock_label = t(".stock_left", count: variant.stock) if variant.stock.positive? && variant.low_stock? %>
          <label>
            <%= radio_button_tag :variant_id, variant.id, single_variant && variant.available?,
                  id: "variant_#{variant.id}", disabled: !variant.available?,
                  class: "peer sr-only",
                  data: { variant_picker_target: "size",
                          stock_label: stock_label,
                          action: "change->variant-picker#selectSize" } %>
            <span class="inline-flex min-w-12 cursor-pointer items-center justify-center rounded-md border border-line px-3 py-2 text-sm font-medium transition-colors peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink peer-disabled:cursor-not-allowed peer-disabled:text-muted peer-disabled:line-through"><%= variant.size %></span>
          </label>
        <% end %>
      </div>
    <% end %>
  </fieldset>

  <p class="mt-3 min-h-5 text-[13px] font-medium text-accent" aria-live="polite"
     data-variant-picker-target="stock"></p>

  <p class="mt-1 hidden text-[13px] font-medium text-danger" role="alert"
     data-variant-picker-target="error"></p>

  <% if product.in_stock? %>
    <button type="submit" class="btn-primary mt-5 w-full"><%= t(".add_to_cart") %></button>
  <% else %>
    <p class="mt-5 inline-flex w-full items-center justify-center rounded-md bg-surface px-6 py-3 text-[15px] font-semibold text-muted"><%= t(".out_of_stock") %></p>
  <% end %>
<% end %>
