<%# locals: (product:) -%>
<% colors = product.variants.map(&:color).uniq.sort %>
<% in_stock = product.variants.any? { |variant| variant.stock.positive? } %>
<% status = if !product.active? then t("catalog.product.unavailable") elsif !in_stock then t("catalog.product.out_of_stock") end %>

<article class="group relative flex h-full flex-col overflow-hidden border border-line bg-white transition-all duration-300 ease-out hover:-translate-y-1 hover:border-line hover:shadow-[0_22px_48px_-28px_rgba(28,28,28,0.45)]">
  <% card_body = capture do %>
    <div class="relative aspect-[3/4] overflow-hidden bg-surface">
      <% if product.image.attached? %>
        <%= image_tag product.image, alt: product.name, loading: "lazy",
              class: "h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" %>
      <% end %>
      <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/10 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></span>
    </div>

    <div class="flex flex-1 flex-col px-4 pb-4 pt-4">
      <h3 class="font-display text-[15px] font-medium leading-snug tracking-wide <%= "transition-colors duration-300 group-hover:text-accent" if product.active? %>"><%= product.name %></h3>
      <p class="mt-1.5 text-[12px] text-muted"><%= colors.join(" / ") %></p>

      <div class="mt-auto flex items-baseline justify-between gap-2 pt-3">
        <p class="text-[14px] font-semibold"><%= number_to_currency(product.price) %></p>
        <% if status %>
          <p class="text-[10px] font-semibold uppercase tracking-[0.1em] text-muted"><%= status %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# A hidden product stays in favourites but has no page to open. %>
  <% if product.active? %>
    <%= link_to product_path(product), class: "block", data: { turbo_frame: "_top" } do %><%= card_body %><% end %>
  <% else %>
    <div class="block opacity-60"><%= card_body %></div>
  <% end %>

  <span class="pointer-events-none absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 bg-accent transition-transform duration-500 ease-out group-hover:scale-x-100" aria-hidden="true"></span>

  <div class="absolute right-3 top-3 z-10"><%= render "favorites/button", product: product %></div>
</article>
