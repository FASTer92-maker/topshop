<%# locals: (product:) -%>
<% colors = product.variants.map(&:color).uniq.sort %>
<% in_stock = product.variants.any? { |variant| variant.stock.positive? } %>
<% status = if !product.active? then t("catalog.product.unavailable") elsif !in_stock then t("catalog.product.out_of_stock") end %>

<article class="group relative flex h-full flex-col border border-line bg-white transition duration-300 hover:-translate-y-1 hover:shadow-[0_12px_24px_rgba(0,0,0,0.08)]">
  <% card_body = capture do %>
    <div class="flex aspect-[4/5] items-center justify-center overflow-hidden bg-[#f9f9f9] p-4">
      <% if product.image.attached? %>
        <%= image_tag product.image, alt: product.name, loading: "lazy",
              class: "h-full w-full object-contain transition-transform duration-300 group-hover:scale-[1.03]" %>
      <% end %>
    </div>

    <div class="flex flex-1 flex-col px-4 pb-4 pt-3">
      <h3 class="text-[13px] font-semibold leading-snug <%= "group-hover:text-accent" if product.active? %>"><%= product.name %></h3>
      <p class="mt-1 text-[12px] text-muted"><%= colors.join(" / ") %></p>

      <div class="mt-auto flex items-baseline justify-between gap-2 pt-2">
        <p class="text-[13px] font-bold"><%= number_to_currency(product.price) %></p>
        <% if status %>
          <p class="text-[10px] font-semibold uppercase tracking-[0.08em] text-muted"><%= status %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# A hidden product stays in favourites but has no page to open. %>
  <% if product.active? %>
    <%= link_to product_path(product), class: "block", data: { turbo_frame: "_top" } do %><%= card_body %><% end %>
  <% else %>
    <div class="block opacity-60"><%= card_body %></div>
  <% end %>

  <div class="absolute right-2 top-2 z-10"><%= render "favorites/button", product: product %></div>
</article>
