<%# locals: (products:) -%>
<% if products.any? %>
  <section id="similar_products" class="mt-12 border-t border-line pt-8">
    <h2 class="heading-display text-[22px] sm:text-[26px]"><%= t(".title") %></h2>

    <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-4">
      <% products.each do |product| %>
        <li><%= render "products/product", product: product %></li>
      <% end %>
    </ul>
  </section>
<% end %>
