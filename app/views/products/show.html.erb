<% content_for :title, @product.name %>

<div class="page-container py-8 md:py-12">
  <%= render "catalog/breadcrumbs", category: @product.category, product: @product %>

  <div class="mt-6 grid gap-8 lg:grid-cols-2 lg:gap-12">
    <div class="aspect-[3/4] overflow-hidden rounded bg-surface">
      <% if @product.image.attached? %>
        <%= image_tag @product.image, alt: @product.name, class: "h-full w-full object-cover" %>
      <% end %>
    </div>

    <div>
      <h1 class="heading-display text-[28px] sm:text-[36px]"><%= @product.name %></h1>

      <p class="mt-3 flex flex-wrap items-center gap-x-2 text-[13px] text-muted">
        <% if @product.section %>
          <%= link_to @product.section.name, category_path(@product.section), class: "link-underline" %>
          <span aria-hidden="true">›</span>
        <% end %>
        <%= link_to @product.category.name, category_path(@product.category), class: "link-underline" %>
      </p>

      <p class="mt-5 text-[22px] font-semibold"><%= number_to_currency(@product.price) %></p>

      <%= render "products/variant_picker", product: @product %>
    </div>
  </div>

  <% if @product.description.present? %>
    <section class="mt-12 max-w-3xl border-t border-line pt-8">
      <h2 class="heading-display text-[22px] sm:text-[26px]"><%= t(".description") %></h2>
      <p class="mt-3 whitespace-pre-line leading-relaxed"><%= @product.description %></p>
    </section>
  <% end %>

  <%= render "products/similar", products: @similar_products %>
</div>
