<% content_for :title, @product.name %>

<div class="page-container pb-16 pt-10 md:pt-14">
  <%= render "catalog/breadcrumbs", category: @product.category, product: @product %>

  <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-16">
    <div class="border border-line bg-white p-5 sm:p-10">
      <div class="flex aspect-[4/5] items-center justify-center">
        <% if @product.image.attached? %>
          <%= image_tag @product.image, alt: @product.name, class: "h-full w-full object-contain" %>
        <% end %>
      </div>
    </div>

    <div class="lg:pt-1">
      <div class="flex items-start justify-between gap-4">
        <h1 class="heading-display text-[26px] sm:text-[32px]"><%= @product.name %></h1>
        <%= render "favorites/button", product: @product %>
      </div>

      <p class="mt-4 text-[20px] font-bold"><%= number_to_currency(@product.price) %></p>

      <p class="mt-2 flex flex-wrap items-center gap-x-2 text-[12px] uppercase tracking-[0.06em] text-muted">
        <% if @product.section %>
          <%= link_to @product.section.name, category_path(@product.section), class: "transition-colors hover:text-ink" %>
          <span aria-hidden="true">›</span>
        <% end %>
        <%= link_to @product.category.name, category_path(@product.category), class: "transition-colors hover:text-ink" %>
      </p>

      <%= render "products/variant_picker", product: @product %>

      <% if @product.description.present? %>
        <section class="mt-8 border-t border-line pt-6">
          <h2 class="text-[12px] font-semibold uppercase tracking-[0.1em]"><%= t(".description") %></h2>
          <p class="mt-3 whitespace-pre-line text-[14px] leading-relaxed text-muted"><%= @product.description %></p>
        </section>
      <% end %>
    </div>
  </div>

  <%= render "products/similar", products: @similar_products %>
</div>
