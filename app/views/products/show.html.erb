<% content_for :title, @product.name %>

<div class="page-container pb-20 pt-10 md:pt-14">
  <%= render "catalog/breadcrumbs", category: @product.category, product: @product %>

  <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-14">
    <div class="border border-line bg-gradient-to-br from-white to-surface p-5 sm:p-10">
      <div class="flex aspect-[3/4] items-center justify-center">
        <% if @product.image.attached? %>
          <%= image_tag @product.image, alt: @product.name, class: "h-full w-full object-contain" %>
        <% end %>
      </div>
    </div>

    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="flex flex-wrap items-center gap-x-2 text-[11px] uppercase tracking-[0.14em] text-muted">
        <% if @product.section %>
          <%= link_to @product.section.name, category_path(@product.section), class: "transition-colors duration-300 hover:text-accent" %>
          <span aria-hidden="true">›</span>
        <% end %>
        <%= link_to @product.category.name, category_path(@product.category), class: "transition-colors duration-300 hover:text-accent" %>
      </p>

      <div class="mt-3 flex items-start justify-between gap-4">
        <h1 class="heading-display text-[30px] sm:text-[38px]"><%= @product.name %></h1>
        <%= render "favorites/button", product: @product %>
      </div>

      <p class="mt-4 text-[24px] font-semibold tracking-wide"><%= number_to_currency(@product.price) %></p>

      <%= render "products/variant_picker", product: @product %>

      <div class="mt-6 grid gap-3 border-t border-line pt-5 text-[12px] leading-relaxed text-muted sm:grid-cols-2">
        <p class="flex items-start gap-2">
          <span class="mt-1.5 size-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
          <%= t(".delivery") %>
        </p>
        <p class="flex items-start gap-2">
          <span class="mt-1.5 size-1.5 shrink-0 bg-accent" aria-hidden="true"></span>
          <%= t(".returns") %>
        </p>
      </div>

      <% if @product.description.present? %>
        <section class="mt-8 border-t border-line pt-6">
          <h2 class="font-display text-[15px] font-medium uppercase tracking-wider"><%= t(".description") %></h2>
          <p class="mt-3 whitespace-pre-line text-[14px] leading-relaxed text-muted"><%= @product.description %></p>
        </section>
      <% end %>
    </div>
  </div>

  <%= render "products/similar", products: @similar_products %>
</div>
