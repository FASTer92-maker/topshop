<% content_for :title, t(".title") %>

<div class="flex flex-wrap items-end justify-between gap-5 border-b border-line pb-7">
  <div>
    <p class="text-sm font-medium uppercase tracking-[0.24em] text-accent"><%= t(".eyebrow") %></p>
    <h1 class="heading-display mt-3 text-[34px] sm:text-[44px]"><%= t(".title") %></h1>
    <p class="mt-3 text-[15px] text-muted"><%= t(".welcome") %></p>
  </div>

  <%= link_to t(".all_orders"), admin_orders_path, class: "btn-secondary" %>
</div>

<div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
  <% { "pending" => t(".stats.pending"), "paid" => t(".stats.paid"), "assembled" => t(".stats.assembled") }.each do |status, label| %>
    <%= link_to admin_orders_path(status: status),
          class: "group border border-line bg-white p-5 transition-colors duration-300 hover:border-accent",
          data: { stat: status } do %>
      <p class="text-[13px] font-medium uppercase tracking-[0.1em] text-muted"><%= label %></p>
      <p class="mt-3 font-display text-[38px] leading-none"><%= @status_counts.fetch(status, 0) %></p>
      <p class="mt-3 text-sm text-muted"><%= t(".stats.orders_hint") %></p>
    <% end %>
  <% end %>

  <div class="border border-ink bg-ink p-5 text-white" data-stat="revenue">
    <p class="text-[13px] font-medium uppercase tracking-[0.1em] text-white/60"><%= t(".stats.revenue") %></p>
    <p class="mt-3 font-display text-[30px] leading-none"><%= number_to_currency(@revenue) %></p>
    <p class="mt-3 text-sm text-white/60"><%= t(".stats.revenue_hint") %></p>
  </div>

  <div class="border border-line bg-white p-5" data-stat="subscribers">
    <p class="text-[13px] font-medium uppercase tracking-[0.1em] text-muted"><%= t(".stats.subscribers") %></p>
    <p class="mt-3 font-display text-[38px] leading-none"><%= @subscribers_count %></p>
    <p class="mt-3 text-sm text-muted"><%= t(".stats.subscribers_hint") %></p>
  </div>
</div>

<div class="mt-8 grid gap-6 xl:grid-cols-2">
  <section id="low_stock" class="overflow-hidden border border-line bg-white">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line px-5 py-4">
      <h2 class="heading-display text-[20px]"><%= t(".low_stock.title") %></h2>
      <span class="text-sm text-muted">
        <%= t(".low_stock.count", count: @low_stock_variants.size) %>
      </span>
    </div>

    <% if @low_stock_variants.empty? %>
      <p class="px-5 py-8 text-sm text-muted"><%= t(".low_stock.empty") %></p>
    <% else %>
      <ul class="divide-y divide-line">
        <% @low_stock_variants.each do |variant| %>
          <li class="flex items-center justify-between gap-4 px-5 py-4">
            <div class="min-w-0">
              <p class="truncate font-medium"><%= variant.product.name %></p>
              <p class="mt-1 text-sm text-muted"><%= variant.label %> · <%= variant.sku %></p>
            </div>
            <span class="shrink-0 px-3 py-1 text-[13px] font-semibold uppercase tracking-[0.06em] <%= variant.stock.zero? ? "bg-danger text-white" : "bg-surface text-danger" %>">
              <%= t(".low_stock.stock", count: variant.stock) %>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section id="recent_orders" class="overflow-hidden border border-line bg-white">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line px-5 py-4">
      <h2 class="heading-display text-[20px]"><%= t(".recent_orders.title") %></h2>
      <%= link_to t(".recent_orders.all"), admin_orders_path, class: "text-sm font-medium link-underline" %>
    </div>

    <% if @recent_orders.empty? %>
      <p class="px-5 py-8 text-sm text-muted"><%= t(".recent_orders.empty") %></p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[560px] border-collapse text-left text-sm">
          <thead>
            <tr class="bg-surface text-[13px] uppercase tracking-[0.08em] text-muted">
              <th scope="col" class="px-5 py-3 font-medium"><%= t(".recent_orders.number") %></th>
              <th scope="col" class="px-5 py-3 font-medium"><%= t(".recent_orders.customer") %></th>
              <th scope="col" class="px-5 py-3 text-right font-medium"><%= t(".recent_orders.total") %></th>
              <th scope="col" class="px-5 py-3 text-right font-medium"><%= t(".recent_orders.status") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @recent_orders.each do |order| %>
              <tr class="transition-colors duration-300 hover:bg-surface/60">
                <td class="px-5 py-4">
                  <%= link_to order.number, admin_order_path(order), class: "font-medium link-underline" %>
                  <p class="mt-1 text-sm text-muted"><%= l(order.created_at, format: :short) %></p>
                </td>
                <td class="px-5 py-4 text-muted"><%= order.full_name %></td>
                <td class="whitespace-nowrap px-5 py-4 text-right font-semibold tabular-nums">
                  <%= number_to_currency(order.total) %>
                </td>
                <td class="px-5 py-4 text-right">
                  <%= render "orders/status_badge", status: order %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>
