<% content_for :title, t(".title") %>

<div class="flex flex-wrap items-end justify-between gap-4 border-b border-line pb-7">
  <div>
    <p class="text-sm font-medium uppercase tracking-[0.24em] text-accent"><%= t("admin.layout.title") %></p>
    <h1 class="heading-display mt-3 text-[34px] sm:text-[44px]"><%= t(".title") %></h1>
  </div>
  <%= link_to t(".new"), new_admin_category_path, class: "btn-primary" %>
</div>

<div class="mt-8 overflow-hidden border border-line bg-white">
  <% if @sections.empty? %>
    <%= render "shared/empty_state", title: t(".empty.title"), text: t(".empty.text") %>
  <% else %>
    <ul>
      <% @sections.each do |section| %>
        <li class="border-b border-line last:border-0">
          <div class="flex flex-wrap items-center gap-4 bg-surface px-5 py-4 sm:px-6">
            <div class="min-w-0 flex-1">
              <p class="font-display text-base font-medium tracking-wide"><%= section.name %></p>
              <p class="mt-1 truncate text-sm text-muted"><%= section.slug %></p>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <%= link_to t(".edit"), edit_admin_category_path(section), class: "link-underline" %>
              <%= button_to t(".delete"), admin_category_path(section), method: :delete,
                    form: { data: { turbo_confirm: t(".confirm") } },
                    class: "cursor-pointer text-danger link-underline" %>
            </div>
          </div>

          <% if section.subcategories.any? %>
            <ul>
              <% section.subcategories.each do |subcategory| %>
                <li class="flex flex-wrap items-center gap-4 border-t border-line px-5 py-3.5 pl-8 sm:px-6 sm:pl-12">
                  <div class="min-w-0 flex-1">
                    <p class="text-[15px] font-medium"><%= subcategory.name %></p>
                    <p class="mt-1 truncate text-sm text-muted"><%= subcategory.slug %></p>
                  </div>
                  <div class="flex items-center gap-3 text-sm">
                    <%= link_to t(".edit"), edit_admin_category_path(subcategory), class: "link-underline" %>
                    <%= button_to t(".delete"), admin_category_path(subcategory), method: :delete,
                          form: { data: { turbo_confirm: t(".confirm") } },
                          class: "cursor-pointer text-danger link-underline" %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
