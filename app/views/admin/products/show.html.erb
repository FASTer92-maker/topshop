<% content_for :title, @product.name %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="text-sm text-muted"><%= @product.category.full_name %></p>
    <h1 class="heading-display text-[28px]"><%= @product.name %></h1>
    <p class="mt-2 text-lg font-semibold"><%= number_to_currency(@product.price) %></p>
  </div>

  <div class="flex items-center gap-4 text-sm">
    <%= link_to t(".edit"), edit_admin_product_path(@product), class: "btn-secondary" %>
    <%= link_to t(".back"), admin_products_path, class: "link-underline" %>
  </div>
</div>

<div class="mt-8 grid gap-8 lg:grid-cols-[240px_1fr]">
  <div>
    <% if @product.image.attached? %>
      <%= image_tag @product.image, alt: @product.name, class: "aspect-[3/4] w-full rounded object-cover" %>
    <% else %>
      <div class="flex aspect-[3/4] w-full items-center justify-center rounded bg-surface text-sm text-muted">
        <%= t(".no_image") %>
      </div>
    <% end %>
  </div>

  <div>
    <span class="inline-block rounded px-2 py-0.5 text-xs font-semibold <%= @product.active? ? "bg-surface" : "bg-line text-muted" %>">
      <%= @product.active? ? t(".active") : t(".hidden") %>
    </span>
    <p class="mt-4 whitespace-pre-line text-muted"><%= @product.description.presence || t(".no_description") %></p>
  </div>
</div>
