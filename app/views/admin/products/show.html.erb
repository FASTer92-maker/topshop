<% content_for :title, @product.name %>

<div class="flex flex-wrap items-start justify-between gap-4 border-b border-line pb-7">
  <div>
    <%= link_to t(".back"), admin_products_path,
          class: "text-sm font-medium text-muted link-underline transition-colors duration-300 hover:text-ink" %>
    <p class="mt-4 text-sm uppercase tracking-[0.12em] text-muted"><%= @product.category.full_name %></p>
    <h1 class="heading-display mt-2 text-[32px] sm:text-[42px]"><%= @product.name %></h1>
    <p class="mt-2 text-[20px] font-semibold tabular-nums"><%= number_to_currency(@product.price) %></p>
  </div>

  <div class="flex flex-wrap items-center gap-3 text-sm">
    <%= link_to t(".edit"), edit_admin_product_path(@product), class: "btn-secondary" %>
  </div>
</div>

<div class="mt-8 grid gap-6 lg:grid-cols-[260px_1fr] lg:gap-8">
  <div class="border border-line bg-white p-4">
    <% if @product.image.attached? %>
      <%= image_tag @product.image, alt: @product.name, class: "aspect-[3/4] w-full object-cover" %>
    <% else %>
      <div class="flex aspect-[3/4] w-full items-center justify-center bg-surface text-sm text-muted">
        <%= t(".no_image") %>
      </div>
    <% end %>
  </div>

  <div class="border border-line bg-white p-6">
    <span class="inline-block px-2.5 py-1 text-[13px] font-semibold uppercase tracking-[0.06em] <%= @product.active? ? "bg-surface" : "bg-line text-muted" %>">
      <%= @product.active? ? t(".active") : t(".hidden") %>
    </span>
    <p class="mt-5 whitespace-pre-line text-[15px] leading-relaxed text-muted"><%= @product.description.presence || t(".no_description") %></p>
  </div>
</div>

<section class="mt-10">
  <h2 class="heading-display text-[24px]"><%= t(".variants.title") %></h2>

  <div class="mt-4 overflow-hidden border border-line bg-white">
    <div id="variants_list" class="divide-y divide-line">
      <% if @product.variants.any? %>
        <%= render partial: "admin/variants/variant", collection: @product.variants, as: :variant %>
      <% else %>
        <%= render "admin/variants/empty" %>
      <% end %>
    </div>

    <div class="border-t border-line bg-surface px-5 py-5 sm:px-6">
      <h3 class="text-[13px] font-semibold uppercase tracking-[0.1em] text-muted"><%= t(".variants.new") %></h3>
      <div class="mt-4">
        <%= render "admin/variants/form", product: @product, variant: @variant %>
      </div>
    </div>
  </div>
</section>
