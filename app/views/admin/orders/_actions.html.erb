<div id="order_actions" class="mt-3">
  <% if order.available_transitions.any? %>
    <div class="flex flex-wrap gap-2">
      <% order.available_transitions.each do |status| %>
        <% cancel = status == "cancelled" %>
        <% label = cancel ? t("admin.orders.actions.cancel") : t("admin.orders.actions.to_status", status: t("orders.statuses.#{status}")) %>
        <%= button_to label, admin_order_path(order, status: status), method: :patch,
              form: (cancel ? { data: { turbo_confirm: t("admin.orders.actions.confirm_cancel") } } : {}),
              class: "cursor-pointer rounded-md border px-4 py-2 text-sm font-semibold transition-colors #{cancel ? "border-danger text-danger hover:bg-danger hover:text-white" : "border-ink bg-white text-ink hover:border-accent hover:text-accent"}" %>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-muted"><%= t("admin.orders.actions.none") %></p>
  <% end %>
</div>
