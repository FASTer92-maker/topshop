<% content_for :title, t(".title") %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="heading-display text-[28px]"><%= t(".title") %></h1>
</div>

<nav aria-label="<%= t(".tabs.label") %>" class="mt-6 flex flex-wrap gap-2">
  <%= link_to t(".tabs.all"), admin_orders_path,
        class: admin_order_tab_class(nil),
        aria: { current: (params[:status].blank? ? "page" : nil) } %>

  <% Order.statuses.each_key do |status| %>
    <%= link_to "#{t("orders.statuses.#{status}")} (#{@status_counts.fetch(status, 0)})",
          admin_orders_path(status: status),
          class: admin_order_tab_class(status),
          aria: { current: (params[:status] == status ? "page" : nil) } %>
  <% end %>
</nav>

<div class="mt-6 overflow-hidden rounded-lg border border-line bg-white">
  <% if @orders.empty? %>
    <%= render "shared/empty_state", title: t(".empty.title"), text: t(".empty.text") %>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[860px] border-collapse text-left text-[15px]">
        <thead>
          <tr class="border-b border-line bg-surface text-[12px] uppercase tracking-wide text-muted">
            <th scope="col" class="px-4 py-3 font-medium"><%= t(".table.number") %></th>
            <th scope="col" class="px-4 py-3 font-medium"><%= t(".table.date") %></th>
            <th scope="col" class="px-4 py-3 font-medium"><%= t(".table.customer") %></th>
            <th scope="col" class="px-4 py-3 text-right font-medium"><%= t(".table.total") %></th>
            <th scope="col" class="px-4 py-3 text-right font-medium"><%= t(".table.status") %></th>
            <th scope="col" class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% @orders.each do |order| %>
            <tr>
              <td class="px-4 py-4">
                <%= link_to order.number, admin_order_path(order), class: "font-semibold link-underline" %>
                <p class="mt-0.5 text-[13px] text-muted"><%= t(".items", count: order.items_count) %></p>
              </td>
              <td class="whitespace-nowrap px-4 py-4 text-muted">
                <%= l(order.created_at, format: :short) %>
              </td>
              <td class="px-4 py-4">
                <p class="font-medium"><%= order.full_name %></p>
                <p class="mt-0.5 text-[13px] text-muted"><%= order.user.email_address %></p>
              </td>
              <td class="whitespace-nowrap px-4 py-4 text-right font-semibold tabular-nums">
                <%= number_to_currency(order.total) %>
              </td>
              <td class="px-4 py-4 text-right">
                <%= render "orders/status_badge", status: order %>
              </td>
              <td class="whitespace-nowrap px-4 py-4 text-right">
                <%= link_to t(".open"), admin_order_path(order), class: "link-underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<%= render "shared/pagination", pagy: @pagy %>
